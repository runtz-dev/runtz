# Everything here is optional: `docker compose up -d` works with no .env at
# all. Copy this file only to change ports. Access is username + password:
# an admin creates a user (just a username) from Settings -> Users and hands
# them the invite link it generates, which lets them set their own password —
# there's no email or OAuth provider to configure.
PORT=8080
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=runtz
RUNTZ_PUBLIC_URL=http://localhost:3000

# Google/GitHub OAuth and Resend email are cloud (runtz.dev) concerns and
# aren't wired into this compose file. If you want them anyway, add the
# matching GOOGLE_CLIENT_ID / GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET /
# RESEND_API_KEY / RESEND_FROM_EMAIL entries to backend.environment in
# docker-compose.yml directly.

# No Stripe keys here on purpose: this installation is self-hosted, and the
# engine never reads STRIPE_* when RUNTZ_DEPLOYMENT_MODE is self-hosted (the
# default). Pro/Enterprise activate from Settings -> Billing instead, which
# opens Checkout through https://engine.runtz.dev — Stripe only runs there.

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Image tag for docker compose. Defaults to :rc (always the newest published
# build) — leave empty to track it. Set this only to pin a specific release
# instead, e.g. RUNTZ_VERSION=1.0.0-rc25.
RUNTZ_VERSION=
NEXT_PUBLIC_API_URL=
RUNTZ_BACKEND_URL=http://backend:8080
BACKEND_PORT=8080
FRONTEND_PORT=3000
MONGODB_PORT=27017
