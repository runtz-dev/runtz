# Everything here is optional: `docker compose up -d` works with no .env at
# all. Copy this file only to change ports or enable OAuth/email login.
PORT=8080
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=runtz
RUNTZ_PUBLIC_URL=http://localhost:3000

# Optional: Google Sign-In (set both to the same OAuth web client id).
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: GitHub OAuth login.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: transactional email (magic links, invites) via Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=runtz <login@runtz.dev>

# No Stripe keys here on purpose: this installation is self-hosted, and the
# engine never reads STRIPE_* when RUNTZ_DEPLOYMENT_MODE is self-hosted (the
# default). Pro/Enterprise activate from Settings -> Billing instead, which
# opens Checkout through https://engine.runtz.dev — Stripe only runs there.

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Docker image version and host ports for docker compose.
RUNTZ_VERSION=1.0.0-rc24
NEXT_PUBLIC_API_URL=
RUNTZ_BACKEND_URL=http://backend:8080
BACKEND_PORT=8080
FRONTEND_PORT=3000
MONGODB_PORT=27017
