# Everything here is optional: `docker compose up -d` works with no .env at
# all. Copy this file only to change ports or enable OAuth/email login.
PORT=8080
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=runtz
RUNTZ_DEPLOYMENT_MODE=self-hosted
RUNTZ_PUBLIC_URL=http://localhost:3000

# Optional: Google Sign-In (set both to the same OAuth web client id).
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: GitHub OAuth login.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: transactional email (magic links, invites) via Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Runtz <login@runtz.dev>

# Stripe billing is only configured on the central/cloud engine.
# Self-hosted installations activate paid plans through https://engine.runtz.dev.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_CLOUD=
STRIPE_PRICE_ENTERPRISE_CLOUD=
STRIPE_PRICE_PRO_SELF_HOSTED=
STRIPE_PRICE_ENTERPRISE_SELF_HOSTED=

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Docker image version and host ports for docker compose.
RUNTZ_VERSION=1.0.0-rc13
NEXT_PUBLIC_API_URL=
RUNTZ_BACKEND_URL=http://backend:8080
BACKEND_PORT=8080
FRONTEND_PORT=3000
MONGODB_PORT=27017
